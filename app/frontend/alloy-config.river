
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "host"
    replacement  = "auth"
  }

}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.central.receiver]
}

loki.source.journal "journal" {
  max_age    = "24h"
  forward_to = [loki.relabel.journal.receiver]
}

loki.relabel "journal" {
  forward_to = [loki.write.central.receiver]

  rule {
    target_label = "job"
    replacement  = "systemd-journal"
  }
  rule {
    target_label = "host"
    replacement  = "frontend"
  }
}

local.file_match "audit" {
  path_targets = [{"__path__" = "/var/log/audit/audit.log"}]
}

loki.relabel "audit" {
  forward_to = [loki.write.central.receiver]

  rule {
    target_label = "job"
    replacement  = "auditd"
  }
  rule {
    target_label = "host"
    replacement  = "frontend"
  }
}

loki.source.file "audit" {
  targets    = local.file_match.audit.targets
  forward_to = [loki.relabel.audit.receiver]
}

loki.source.file "aide_logs" {
  targets    = local.file_match.aide.targets
  forward_to = [loki.relabel.aide.receiver]
}

local.file_match "aide" {
  path_targets = [{"__path__" = "/var/log/aide/*.log"}]
}

loki.relabel "aide" {
  forward_to = [loki.write.central.receiver]

  rule {
    target_label = "job"
    replacement  = "aide-fim"
  }
  
  rule {
    target_label = "host"
    replacement  = "frontend"
  }
}

loki.write "central" {
  endpoint {
    url = "https://logs.victorojeje.xyz/loki/api/v1/push"
    headers = {
      "CF-Access-Client-Id"     = env("CF_ACCESS_CLIENT_ID"),
      "CF-Access-Client-Secret" = env("CF_ACCESS_CLIENT_SECRET"),
    }
  }
}